@model IEnumerable<IGrouping<SalesWebMvc.Models.Department, SalesWebMvc.Models.SalesRecord>>

@{
    ViewData["Title"] = "Grouping Search";
}

<h2 class="mt-3 text-warning">@ViewData["Title"]</h2>
<hr class="border-warning" />

<div class="row mb-4">
    <div class="col-md-12">
        <div class="custom-table-bg p-4 rounded shadow-sm border-start border-warning border-4">
            <form class="form-inline d-flex align-items-center gap-3">
                <div class="form-group mb-0">
                    <label for="minDate" class="text-white fw-bold me-2">Min Date:</label>
                    <input type="date" class="form-control" name="minDate" value="@ViewData["minDate"]" />
                </div>
                <div class="form-group mb-0">
                    <label for="maxDate" class="text-white fw-bold me-2">Max Date:</label>
                    <input type="date" class="form-control" name="maxDate" value="@ViewData["maxDate"]" />
                </div>
                <button type="submit" class="btn btn-warning fw-bold text-dark mt-4 mt-sm-0">Filter</button>
            </form>
        </div>
    </div>
</div>

@foreach (var departmentGroup in Model)
{
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="custom-table-bg p-4 rounded shadow-sm">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="text-warning m-0">Department: @departmentGroup.Key.Name</h4>
                    <h5 class="text-white m-0">
                        Total Sales = @departmentGroup.Sum(x => x.Amount).ToString("F2")
                    </h5>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover table-dark align-middle mb-0">
                        <thead>
                            <tr class="text-warning border-bottom border-warning">
                                <th>Id</th>
                                <th>Date</th>
                                <th>Amount</th>
                                <th>Seller</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in departmentGroup)
                            {
                                <tr>
                                    <td>@Html.DisplayFor(modelItem => item.Id)</td>
                                    <td>@Html.DisplayFor(modelItem => item.Date)</td>
                                    <td>@Html.DisplayFor(modelItem => item.Amount)</td>
                                    <td>@Html.DisplayFor(modelItem => item.Seller.Name)</td>
                                    <td>
                                        @if (item.Status == SalesWebMvc.Models.Enums.SaleStatus.Billed)
                                        {
                                            <span class="badge bg-success">@item.Status</span>
                                        }
                                        else if (item.Status == SalesWebMvc.Models.Enums.SaleStatus.Pending)
                                        {
                                            <span class="badge bg-warning text-dark">@item.Status</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">@item.Status</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    </div>
}