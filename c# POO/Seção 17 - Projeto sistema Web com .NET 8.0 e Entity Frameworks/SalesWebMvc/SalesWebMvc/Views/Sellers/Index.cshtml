@model IEnumerable<SalesWebMvc.Models.Seller>
@{
    ViewData["Title"] = "Sellers";
}

<h2 class="mt-3">@ViewData["Title"]</h2>

<p>
    <a asp-action="Create" class="btn btn-info fw-bold text-dark mt-2 mb-2">Create new</a>
</p>

<div class="custom-table-bg">
    <table class="table table-hover text-white mb-0">
        <thead>
            <tr class="table-info text-dark">
                <th>@Html.DisplayNameFor(x => x.Name)</th>
                <th>@Html.DisplayNameFor(x => x.Email)</th>
                <th>@Html.DisplayNameFor(x => x.BirthDate)</th>
                <th>@Html.DisplayNameFor(x => x.BaseSalary)</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(x => item.Name)</td>
                    <td>@Html.DisplayFor(x => item.Email)</td>
                    <td>@Html.DisplayFor(x => item.BirthDate)</td>
                    <td>@Html.DisplayFor(x => item.BaseSalary)</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Edit</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Details</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>