@{
    ViewData["Title"] = "Sales Records";
}

<h2 class="mt-3 text-info">@ViewData["Title"]</h2>
<hr class="border-info" />

<div class="row">
    <div class="col-md-6">
        <div class="custom-table-bg p-4 mt-2 mb-4">
            <h4 class="text-white mb-3">Simple Search</h4>
            <form asp-action="SimpleSearch">
                <div class="form-group mb-3">
                    <label class="control-label text-white fw-bold">Min Date</label>
                    <input type="date" name="minDate" class="form-control" />
                </div>
                <div class="form-group mb-4">
                    <label class="control-label text-white fw-bold">Max Date</label>
                    <input type="date" name="maxDate" class="form-control" />
                </div>
                <button type="submit" class="btn btn-info fw-bold text-dark w-100">Submit</button>
            </form>
        </div>
    </div>

    <div class="col-md-6">
        <div class="custom-table-bg p-4 mt-2">
            <h4 class="text-white mb-3">Grouping Search</h4>
            <form asp-action="GroupingSearch">
                <div class="form-group mb-3">
                    <label class="control-label text-white fw-bold">Min Date</label>
                    <input type="date" name="minDate" class="form-control" />
                </div>
                <div class="form-group mb-4">
                    <label class="control-label text-white fw-bold">Max Date</label>
                    <input type="date" name="maxDate" class="form-control" />
                </div>
                <button type="submit" class="btn btn-warning fw-bold text-dark w-100">Submit</button>
            </form>
        </div>
    </div>
</div>